{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/agentic-drive",
  "description": "Store, sort, and share files and folders.",
  "version": "0.10.3",
  "repository": {
    "url": "https://github.com/pooriaarab/agentic-drive",
    "source": "github",
    "id": 0
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "agentic-drive",
      "version": "0.10.3",
      "environmentVariables": [
        { "name": "AGENTIC_DRIVE_TOKEN", "description": "An API key. Make one with `principal add <id>` and `key issue <id>`.", "isRequired": true, "isSecret": true },
        { "name": "AGENTIC_DRIVE_DIR", "description": "The data folder. Default ./.agentic-drive.", "isRequired": false, "isSecret": false }
      ],
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "valueHint": "subcommand", "value": "mcp" }
      ]
    }
  ]
}
