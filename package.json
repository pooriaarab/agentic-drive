{
  "name": "agentic-drive",
  "version": "0.9.0",
  "description": "Store, sort, and share files and folders.",
  "keywords": [
    "drive",
    "files",
    "folders",
    "storage",
    "upload",
    "sharing",
    "agents",
    "mcp",
    "cli",
    "r2"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-drive.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "ui-dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-drive",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build --silent >&2 && npm run build:ui --silent >&2",
    "ci:local": "npm run build && npm run build:ui && npm run typecheck && npm test && npm run test:e2e",
    "build:ui": "vite build",
    "deploy:demo": "npm run build:ui && wrangler deploy -c wrangler.demo.jsonc",
    "test:e2e": "playwright test",
    "dev": "npm run build:ui && WRANGLER_SEND_METRICS=false wrangler dev --local --var DRIVE_PUBLIC_URL:http://127.0.0.1:8787 --var DRIVE_REGION:unknown",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-design": "^0.4.0",
    "agentic-identity": "^0.6.0",
    "hono": "^4.13.14",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.27.7",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20260730.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "bin": {
    "agentic-drive": "./dist/cli.js"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "agentic-design": {
      "zod": "^4.6.6"
    }
  }
}
